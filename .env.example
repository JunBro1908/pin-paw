# PinPaw local environment template
# Copy to .env.local and fill values. Do not put spaces around '='.

# Canonical app origin (exact). Use http://localhost:3000 for local.
APP_ORIGIN=http://localhost:3000

# Supabase project (URL + anon + service_role must be the SAME project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Naver Maps JavaScript (NCP Maps ncpKeyId) — separate from Search
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Naver Search API (developers.naver.com — 검색)
NEXT_PUBLIC_NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Workers / cron
CRON_SECRET=
OPENAI_API_KEY=

# Public data (구조동물 주간 import) — data.go.kr 인증키
DATA_GO_KR_SERVICE_KEY=

# Observability
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Manual Supabase Auth checklist (not env-gated) ---
# 1) Authentication → Providers → Kakao: Enable + REST key/secret
# 2) URL Configuration Site URL = APP_ORIGIN
# 3) Redirect URLs include {APP_ORIGIN}/auth/callback
# 4) Kakao Developers Redirect URI includes
#    https://YOUR_PROJECT.supabase.co/auth/v1/callback
